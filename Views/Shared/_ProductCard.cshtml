@model WebDS_Test.Services.ProductCard
@inject WebDS_Test.Services.ICurrencyFormatter Money
@{
    var card = Model;
}
<div class="card card-hover">
    <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@card.Slug" class="text-decoration-none">
        <div class="product-thumb">
            @if (!string.IsNullOrEmpty(card.ImageUrl))
            {
                <img src="@card.ImageUrl" alt="@card.Name" loading="lazy" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center h-100 text-muted">No image</div>
            }

            <div class="thumb-badges">
                @if (card.IsOnSale)
                {
                    <span class="badge text-bg-danger">-@card.DiscountPercent%</span>
                }
                @if (card.IsFeatured)
                {
                    <span class="badge text-bg-warning">Featured</span>
                }
            </div>

            @if (!card.InStock)
            {
                <div class="stock-ribbon">Out of stock</div>
            }
            else if (card.StockQuantity <= 5)
            {
                <div class="stock-ribbon">Only @card.StockQuantity left</div>
            }
        </div>
    </a>

    <div class="card-body d-flex flex-column">
        <div class="small text-muted mb-1 d-flex flex-wrap align-items-center gap-1">
            <span>@card.CategoryName</span>
            @if (!string.IsNullOrEmpty(card.ShopName))
            {
                <span aria-hidden="true">·</span>
                <a class="product-seller text-decoration-none"
                   asp-area="" asp-controller="Shops" asp-action="Details" asp-route-slug="@card.ShopSlug">@card.ShopName</a>
            }
        </div>

        <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@card.Slug" class="text-decoration-none">
            <h3 class="product-title mb-2">@card.Name</h3>
        </a>

        @if (card.HasRating)
        {
            <a class="product-rating d-inline-flex align-items-center gap-1 mb-2 text-decoration-none"
               asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@card.Slug" asp-fragment="reviews">
                <partial name="_Stars" model="card.Stars" />
                <span class="small text-muted">@card.RatingAverage.ToString("0.0") (@card.RatingCount)</span>
            </a>
        }

        @if (!string.IsNullOrEmpty(card.ShortDescription))
        {
            <p class="small text-muted text-truncate-2 mb-2">@card.ShortDescription</p>
        }

        <div class="mt-auto">
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="price-now">@Money.Format(card.Price)</span>
                @if (card.HasPriceRange)
                {
                    <span class="small text-muted">and up</span>
                }
                @if (card.IsOnSale)
                {
                    <span class="price-was">@Money.Format(card.CompareAtPrice)</span>
                }
            </div>

            <a class="btn btn-outline-primary btn-sm w-100"
               asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@card.Slug">
                View details
            </a>
        </div>
    </div>
</div>
