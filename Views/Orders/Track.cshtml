@model WebDS_Test.Controllers.TrackOrderViewModel
@{
    ViewData["Title"] = "Track an order";

    // Keep the summary in the DOM for the client validator, but only paint it as an alert when
    // there is actually something to show.
    var summaryClass = ViewData.ModelState.IsValid ? "text-danger small" : "alert alert-danger";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Track an order</h1>
                <p class="text-muted">
                    Enter the order number from your confirmation and the email address you used at checkout.
                    No account needed.
                </p>

                <form method="post" asp-controller="Orders" asp-action="Track">
                    <div asp-validation-summary="ModelOnly" class="@summaryClass" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="OrderNumber"></label>
                        <input class="form-control" asp-for="OrderNumber" placeholder="ORD-2026-0001"
                               autocomplete="off" autofocus />
                        <span class="text-danger small" asp-validation-for="OrderNumber"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Email"></label>
                        <input class="form-control" asp-for="Email" type="email" autocomplete="email"
                               placeholder="you&#64;example.com" />
                        <span class="text-danger small" asp-validation-for="Email"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg" type="submit">Find my order</button>
                    </div>
                </form>

                <hr />

                <p class="text-muted small mb-0">
                    Signed in? Your full order history is on the
                    <a asp-controller="Orders" asp-action="Index">orders page</a>.
                    Looking for something to buy? Browse the
                    <a asp-controller="Catalog" asp-action="Index">catalogue</a>.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
