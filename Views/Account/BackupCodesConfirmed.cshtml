@model BackupCodesConfirmedViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "New backup codes";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">New backup codes generated</h1>
                <a class="btn btn-outline-secondary" asp-action="TwoFactor">Back to settings</a>
            </div>

            <div class="alert alert-warning" role="alert">
                <svg class="bi me-2" width="24" height="24" role="img" aria-label="Warning"><use xlink:href="#exclamation-triangle-fill"/></use>
                <strong>Your previous backup codes are now invalid.</strong> Save these new codes in a safe place.
            </div>

            <div class="card mb-4">
                <div class="card-header bg-white"><h2 class="h5 mb-0">Your backup codes</h2></div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Each code can be used once instead of your authenticator app.
                        If you lose access to your authenticator app, these are the only way to sign in.
                    </p>

                    <div class="row g-2">
                        @for (var i = 0; i < Model.BackupCodes.Length; i++)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="p-2 bg-light border rounded text-center">
                                    <code class="fw-bold">@Model.BackupCodes[i]</code>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" onclick="copyAllCodes()">Copy all codes</button>
                        <a class="btn btn-primary" asp-action="TwoFactor">Done, go to settings</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyAllCodes() {
            const codes = @Html.Raw(JsonSerializer.Serialize(Model.BackupCodes));
            navigator.clipboard.writeText(codes.join('\n')).then(() => {
                const btn = document.querySelector('button[onclick="copyAllCodes()"]');
                const original = btn.innerText;
                btn.innerText = 'Copied!';
                setTimeout(() => btn.innerText = original, 2000);
            });
        }
    </script>
}