@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    var summaryClass = ViewData.ModelState.IsValid ? "text-danger small" : "alert alert-danger";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Choose a new password</h1>

                <form method="post" asp-controller="Account" asp-action="ResetPassword">
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="@summaryClass" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Password"></label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" autofocus />
                        <span class="text-danger small" asp-validation-for="Password"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmPassword"></label>
                        <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                        <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg" type="submit">Set my new password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
