@model RegisterViewModel
@{
    ViewData["Title"] = "Create an account";

    var summaryClass = ViewData.ModelState.IsValid ? "text-danger small" : "alert alert-danger";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Create an account</h1>
                <p class="text-muted">
                    An account keeps your cart, wishlist, saved addresses and order history together.
                    This is a demo store — use any details you like, but not a real password.
                </p>

                <form method="post" asp-controller="Account" asp-action="Register">
                    <div asp-validation-summary="ModelOnly" class="@summaryClass" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="DisplayName"></label>
                        <input class="form-control" asp-for="DisplayName" autocomplete="name" autofocus />
                        <span class="text-danger small" asp-validation-for="DisplayName"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Email"></label>
                        <input class="form-control" asp-for="Email" type="email" autocomplete="email" />
                        <span class="text-danger small" asp-validation-for="Email"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Phone"></label>
                        <input class="form-control" asp-for="Phone" type="tel" autocomplete="tel" />
                        <span class="text-danger small" asp-validation-for="Phone"></span>
                        <div class="form-text">Optional — used for delivery questions only.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Password"></label>
                            <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
                            <span class="text-danger small" asp-validation-for="Password"></span>
                            <div class="form-text">At least 8 characters.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="ConfirmPassword"></label>
                            <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                            <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
                        </div>
                    </div>

                    <div class="form-check mt-3 mb-3">
                        <input class="form-check-input" asp-for="AcceptTerms" />
                        <label class="form-check-label" asp-for="AcceptTerms">
                            I accept the store's
                            <a asp-controller="Home" asp-action="Privacy">shipping, returns and privacy terms</a>.
                        </label>
                        <span class="text-danger small d-block" asp-validation-for="AcceptTerms"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg" type="submit">Create my account</button>
                    </div>
                </form>

                <hr />

                <p class="mb-0 small">
                    Already registered? <a asp-controller="Account" asp-action="Login">Sign in</a>.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
