@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
    var summaryClass = ViewData.ModelState.IsValid ? "text-danger small" : "alert alert-danger";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Reset your password</h1>

                <p class="text-muted">
                    Enter the email address on your account and we will send a link you can use to choose a
                    new password. The link expires after a couple of hours.
                </p>

                <form method="post" asp-controller="Account" asp-action="ForgotPassword">
                    <div asp-validation-summary="ModelOnly" class="@summaryClass" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Email"></label>
                        <input class="form-control" asp-for="Email" type="email" autocomplete="email" autofocus />
                        <span class="text-danger small" asp-validation-for="Email"></span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg" type="submit">Email me a reset link</button>
                    </div>
                </form>

                <hr />

                <p class="mb-0 small">
                    Remembered it? <a asp-controller="Account" asp-action="Login">Back to sign in</a>.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
