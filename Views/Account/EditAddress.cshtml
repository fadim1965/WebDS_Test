@model AddressFormModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add an address" : "Edit address";

    var summaryClass = ViewData.ModelState.IsValid ? "text-danger small" : "alert alert-danger";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Addresses">Address book</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? "Add an address" : "Edit address")</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">@(isNew ? "Add an address" : "Edit address")</h1>
                <p class="text-muted small">
                    We only use these details to deliver your orders. They are stored with your account.
                </p>

                <form method="post" asp-controller="Account" asp-action="EditAddress">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="@summaryClass" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" asp-for="FullName"></label>
                            <input class="form-control" asp-for="FullName" autocomplete="name" />
                            <span class="text-danger small" asp-validation-for="FullName"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Phone"></label>
                            <input class="form-control" asp-for="Phone" type="tel" autocomplete="tel" />
                            <span class="text-danger small" asp-validation-for="Phone"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" asp-for="Line1"></label>
                            <input class="form-control" asp-for="Line1" autocomplete="address-line1" />
                            <span class="text-danger small" asp-validation-for="Line1"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" asp-for="Line2"></label>
                            <input class="form-control" asp-for="Line2" autocomplete="address-line2" />
                            <span class="text-danger small" asp-validation-for="Line2"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="City"></label>
                            <input class="form-control" asp-for="City" autocomplete="address-level2" />
                            <span class="text-danger small" asp-validation-for="City"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="State"></label>
                            <input class="form-control" asp-for="State" autocomplete="address-level1" />
                            <span class="text-danger small" asp-validation-for="State"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="PostalCode"></label>
                            <input class="form-control" asp-for="PostalCode" autocomplete="postal-code" />
                            <span class="text-danger small" asp-validation-for="PostalCode"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Country"></label>
                            <input class="form-control" asp-for="Country" autocomplete="country-name" />
                            <span class="text-danger small" asp-validation-for="Country"></span>
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input" asp-for="IsDefault" />
                        <label class="form-check-label" asp-for="IsDefault">Use as my default address</label>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button class="btn btn-primary" type="submit">
                            @(isNew ? "Save address" : "Update address")
                        </button>
                        <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Addresses">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
