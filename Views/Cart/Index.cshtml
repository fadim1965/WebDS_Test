@model CartViewModel
@{
    ViewData["Title"] = "Your cart";
    var currency = Model.Settings.CurrencySymbol;
}

<div class="row g-4">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Your cart</h1>

        @if (Model.Cart is null || Model.Cart.IsEmpty)
        {
            <div class="alert alert-info">Your cart is empty.</div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">Continue shopping</a>
        }
        else
        {
            @if (Model.Issues.Count > 0)
            {
                <div class="alert alert-warning" role="alert">
                    <div class="fw-semibold mb-1">Some items need your attention</div>
                    <ul class="mb-0 ps-3">
                        @foreach (var issue in Model.Issues)
                        {
                            <li>@issue</li>
                        }
                    </ul>
                </div>
            }

            <div class="card mb-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col" class="text-end">Price</th>
                                <th scope="col" class="text-center" style="width:11rem">Quantity</th>
                                <th scope="col" class="text-end">Total</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cart.Items)
                            {
                                var name = item.ProductVariant?.Product?.Name ?? "Unavailable item";
                                var variant = item.ProductVariant?.Name;
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@name</div>
                                        @if (!string.IsNullOrWhiteSpace(variant))
                                        {
                                            <div class="small text-muted">@variant</div>
                                        }
                                    </td>
                                    <td class="text-end">@currency@item.UnitPrice.ToString("N2")</td>
                                    <td>
                                        <form asp-action="Update" method="post" class="d-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1"
                                                   class="form-control form-control-sm text-center" style="width:4.5rem" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                                        </form>
                                    </td>
                                    <td class="text-end">@currency@item.LineTotal.ToString("N2")</td>
                                    <td class="text-end">
                                        <form asp-action="Remove" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">Continue shopping</a>
                <form asp-action="Clear" method="post"
                      onsubmit="return confirm('Remove every item from your cart?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Empty cart</button>
                </form>
            </div>

            <div class="card">
                <div class="card-body">
                    <h2 class="h6 mb-3">Discount code</h2>

                    @if (!string.IsNullOrWhiteSpace(Model.AppliedCouponCode))
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge text-bg-success">@Model.AppliedCouponCode</span>
                            <span class="text-success">−@currency@Model.Discount.ToString("N2")</span>
                            <form asp-controller="Coupons" asp-action="Remove" method="post" class="ms-auto">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-link text-decoration-none">Remove</button>
                            </form>
                        </div>
                    }

                    <form asp-controller="Coupons" asp-action="Apply" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-12 col-sm-6">
                            <label class="visually-hidden" for="couponCode">Coupon code</label>
                            <input id="couponCode" name="Code" class="form-control text-uppercase"
                                   placeholder="Enter a code" autocomplete="off" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-outline-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h2 class="h6 mb-0">Order summary</h2></div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-1">
                    <span>Subtotal</span>
                    <span>@currency@Model.Subtotal.ToString("N2")</span>
                </div>

                @if (Model.Discount > 0m)
                {
                    <div class="d-flex justify-content-between mb-1 text-success">
                        <span>Discount @(string.IsNullOrWhiteSpace(Model.AppliedCouponCode) ? string.Empty : $"({Model.AppliedCouponCode})")</span>
                        <span>−@currency@Model.Discount.ToString("N2")</span>
                    </div>
                }

                <div class="d-flex justify-content-between mb-1">
                    <span>Shipping</span>
                    <span>@(Model.FinalShipping == 0m ? "Free" : currency + Model.FinalShipping.ToString("N2"))</span>
                </div>

                <div class="d-flex justify-content-between mb-1">
                    <span>Tax</span>
                    <span>@currency@Model.FinalTax.ToString("N2")</span>
                </div>

                <div class="d-flex justify-content-between border-top pt-2 mt-2 fw-bold fs-5">
                    <span>Total</span>
                    <span>@currency@Model.FinalTotal.ToString("N2")</span>
                </div>

                @if (Model.FreeShippingShortfall > 0m)
                {
                    <div class="form-text mt-2">
                        Spend @currency@Model.FreeShippingShortfall.ToString("N2") more for free shipping.
                    </div>
                }

                <div class="mt-3">
                    @if (Model.CanCheckout)
                    {
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary w-100">Proceed to checkout</a>
                    }
                    else
                    {
                        <button class="btn btn-primary w-100" disabled>Resolve cart issues to check out</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
