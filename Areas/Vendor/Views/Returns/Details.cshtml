@model WebDS_Test.Domain.ReturnRequest
@{
    var currency = (string)(ViewData["Currency"] ?? "$");
    var order = Model.Order;
    var canDecide = (bool?)ViewData["CanDecide"] ?? true;

    string Money(decimal value) => currency + value.ToString("N2");
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Returns</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Reference</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
        <div>
            <h1 class="h3 mb-1">Return @Model.Reference</h1>
            <p class="text-muted mb-0">
                Order
                <a asp-area="Vendor" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">
                    @(order?.OrderNumber ?? $"#{Model.OrderId}")
                </a>
                &middot; requested @Model.RequestedUtc.ToString("yyyy-MM-dd HH:mm") UTC
                &middot; <span class="badge @Model.Status.ToCssClass()">@Model.Status.ToDisplay()</span>
            </p>
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-white fw-semibold">Shopper</div>
                <div class="card-body small">
                    <div class="fw-semibold fs-6">@(order?.CustomerName ?? "Guest")</div>
                    <div><a href="mailto:@Model.Email">@Model.Email</a></div>
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
                    {
                        <hr class="my-2" />
                        <div class="text-muted">Reason given:</div>
                        <div style="white-space: pre-line">@Model.CustomerNote</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-white fw-semibold">History</div>
                <div class="card-body small">
                    <div>Requested @Model.RequestedUtc.ToString("yyyy-MM-dd HH:mm")</div>
                    @if (Model.DecidedUtc is { } decided)
                    {
                        <div>Decided @decided.ToString("yyyy-MM-dd HH:mm") — @Model.Status.ToDisplay()</div>
                    }
                    @if (Model.ReceivedUtc is { } received)
                    {
                        <div>Received @received.ToString("yyyy-MM-dd HH:mm")</div>
                    }
                    @if (Model.RefundedUtc is { } refunded)
                    {
                        <div>Refunded @refunded.ToString("yyyy-MM-dd HH:mm") @Money(Model.RefundAmount)</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.HandledBy))
                    {
                        <div class="text-muted">Handled by @Model.HandledBy</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DecisionNote))
                    {
                        <hr class="my-2" />
                        <div class="text-muted">Note: @Model.DecisionNote</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-white fw-semibold">Actions</div>
                <div class="card-body">
                    @if (!canDecide && Model.Status is ReturnStatus.Requested or ReturnStatus.Approved)
                    {
                        <p class="small text-muted mb-0">
                            A manager or the owner has to approve and receive returns. You can still
                            read the request and its history.
                        </p>
                    }
                    else if (Model.Status == ReturnStatus.Requested)
                    {
                        <form asp-action="Decide" asp-route-id="@Model.Id" method="post" class="mb-2">
                            <input type="hidden" name="approve" value="true" />
                            <label for="approveNote" class="form-label small fw-semibold">Note to the shopper (optional)</label>
                            <textarea id="approveNote" name="note" rows="2" class="form-control form-control-sm mb-2"></textarea>
                            <button type="submit" class="btn btn-success btn-sm w-100">Approve return</button>
                        </form>
                        <form asp-action="Decide" asp-route-id="@Model.Id" method="post">
                            <input type="hidden" name="approve" value="false" />
                            <label for="rejectNote" class="form-label small fw-semibold">Reason for rejection</label>
                            <textarea id="rejectNote" name="note" rows="2" class="form-control form-control-sm mb-2"></textarea>
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Reject return</button>
                        </form>
                    }
                    else if (Model.Status == ReturnStatus.Approved)
                    {
                        <p class="small text-muted">
                            Approved. When the goods arrive, mark them received — the units go back
                            on the shelf and the request waits for the marketplace to refund.
                        </p>
                        <form asp-action="Receive" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-sm w-100">Mark goods received</button>
                        </form>
                    }
                    else if (Model.Status == ReturnStatus.Received)
                    {
                        <p class="small text-muted">
                            Goods received. The marketplace's administration issues the refund —
                            it reverses the commission as well as the sale.
                        </p>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">
                            @switch (Model.Status)
                            {
                                case ReturnStatus.Refunded:
                                    <text>Complete — refunded @Money(Model.RefundAmount).</text>
                                    break;
                                case ReturnStatus.Rejected:
                                    <text>Rejected.</text>
                                    break;
                                case ReturnStatus.Cancelled:
                                    <text>The shopper withdrew this request.</text>
                                    break;
                                default:
                                    <text>@Model.Status.ToDisplay()</text>
                                    break;
                            }
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header bg-white fw-semibold">Items returned</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th class="text-center">Qty returned</th>
                        <th class="text-center">Ordered</th>
                        <th class="text-end">Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                @(line.OrderLine?.ProductName ?? "—")
                                @if (!string.IsNullOrWhiteSpace(line.OrderLine?.VariantName))
                                {
                                    <span class="small text-muted">· @line.OrderLine.VariantName</span>
                                }
                            </td>
                            <td><code class="small">@(line.OrderLine?.Sku ?? "—")</code></td>
                            <td class="text-center">@line.Quantity</td>
                            <td class="text-center">@(line.OrderLine?.Quantity.ToString() ?? "—")</td>
                            <td class="text-end text-nowrap">@Money(line.LineTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
