@model IReadOnlyList<SellerFulfilment>
@using WebDS_Test.Domain
@{
    ViewData["Title"] = "Packages & labels";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
        <div>
            <h1 class="h3 mb-1">Packages &amp; labels</h1>
            <p class="text-muted mb-0">
                What @ViewData["ShopName"] has packed and where each consignment is in the LibanPost
                label process.
            </p>
        </div>
        <a class="btn btn-outline-primary btn-sm" asp-area="Vendor" asp-controller="Orders" asp-action="Index">Orders</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border mt-3">
            No packages confirmed yet. Open a paid order, count the packages and request labels from
            the order page.
        </div>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th class="text-end">Packages</th>
                        <th>Nylon</th>
                        <th>Invoice</th>
                        <th class="text-end">Labels</th>
                        <th>Status</th>
                        <th>Confirmed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fulfilment in Model)
                    {
                        <tr>
                            <td>
                                <a asp-area="Vendor" asp-controller="Orders" asp-action="Details"
                                   asp-route-id="@fulfilment.OrderId">@fulfilment.Order?.OrderNumber</a>
                            </td>
                            <td class="text-end">@fulfilment.PackageCount</td>
                            <td>@(fulfilment.HasNylonPockets ? "Attached" : "Missing")</td>
                            <td>@(fulfilment.InvoiceAttached ? "Attached" : "Missing")</td>
                            <td class="text-end">@fulfilment.LabelsGenerated</td>
                            <td><span class="badge @fulfilment.Status.ToCssClass()">@fulfilment.Status.ToDisplay()</span></td>
                            <td class="small text-nowrap">
                                @(fulfilment.SellerConfirmedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
