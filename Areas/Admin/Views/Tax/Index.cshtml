@model WebDS_Test.Areas.Admin.Controllers.TaxController.TaxListViewModel
@{
    ViewData["Title"] = "Tax classes";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Tax classes</h2>
        <p class="text-muted small mb-0">
            Products on a class are taxed at that class's rate. Everything else is taxed at the store
            rate of <strong>@((Model.StoreRate * 100).ToString("0.##"))%</strong>
            (<code>Store:TaxRate</code>).
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Export" asp-route-format="csv">Export CSV</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Export" asp-route-format="xlsx">Export Excel</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Defined classes</div>
            @if (Model.Classes.Count == 0)
            {
                <div class="card-body text-muted small">No tax classes yet. Every product is taxed at the store rate.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col" class="text-end">Rate</th>
                                <th scope="col" class="text-end">Products</th>
                                <th scope="col">State</th>
                                <th scope="col" class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Classes)
                            {
                                <tr>
                                    <td class="fw-semibold">@t.Name</td>
                                    <td class="text-end">
                                        @(t.IsExempt ? "Exempt" : ((t.Rate * 100).ToString("0.##") + "%"))
                                    </td>
                                    <td class="text-end">@t.ProductCount</td>
                                    <td>
                                        @if (t.IsExempt)
                                        {
                                            <span class="badge text-bg-info">Exempt</span>
                                        }
                                        else if (t.IsActive)
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-action="Deactivate" class="d-inline">
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">
                                                @(t.ProductCount > 0 ? "Deactivate" : "Delete")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold">Add a class</div>
            <form method="post" asp-action="Create" class="card-body">
                <div class="mb-3">
                    <label class="form-label required-label" for="name">Name</label>
                    <input class="form-control" id="name" name="name" maxlength="80" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rate">Rate as a fraction</label>
                    <input class="form-control" id="rate" name="rate" type="number" step="0.0001" min="0" max="1"
                           value="@Model.StoreRate.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
                    <div class="form-text">
                        0.11 means eleven percent. A percentage typed here as <code>11</code> would be
                        rejected.
                    </div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="isExempt" name="isExempt" value="true" />
                    <label class="form-check-label" for="isExempt">
                        Exempt — always zero, whatever the rate says
                    </label>
                </div>
                <button class="btn btn-primary" type="submit">Create class</button>
            </form>
        </div>

        <div class="alert alert-secondary small">
            <strong>@Model.UnassignedProducts</strong> live product(s) are not on a class and are taxed
            at the store rate. Assign a class on the product editor to move a product onto a different rate.
        </div>
    </div>
</div>
