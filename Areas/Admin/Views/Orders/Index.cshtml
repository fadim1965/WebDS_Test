@using Microsoft.Extensions.Options
@model AdminOrderListViewModel
@inject IOptions<StoreSettings> StoreOptions
@{
    var currency = StoreOptions.Value.CurrencySymbol;

    string Money(decimal amount) => currency + amount.ToString("N2");
    string Plural(int count, string singular) => count == 1 ? $"{count} {singular}" : $"{count} {singular}s";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Orders</h2>
        <p class="text-muted small mb-0">@Plural(Model.Orders.Count, "order") listed.</p>
    </div>
    <div class="btn-group btn-group-sm" role="group" aria-label="Export orders">
        <a class="btn btn-outline-secondary"
           asp-area="Admin" asp-controller="Orders" asp-action="Export"
           asp-route-status="@Model.Status" asp-route-q="@Model.Search" asp-route-format="csv">Export CSV</a>
        <a class="btn btn-outline-secondary"
           asp-area="Admin" asp-controller="Orders" asp-action="Export"
           asp-route-status="@Model.Status" asp-route-q="@Model.Search" asp-route-format="excel">Export Excel</a>
    </div>
</div>

@if (Model.PendingCount > 0)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
        <span>
            <strong>@Plural(Model.PendingCount, "order")</strong> still awaiting payment or cancellation.
        </span>
        <a class="btn btn-sm btn-warning"
           asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="@OrderStatus.Pending">Show pending only</a>
    </div>
}

<form method="get" asp-area="Admin" asp-controller="Orders" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label" for="q">Search</label>
            <input class="form-control" type="search" id="q" name="q" value="@Model.Search"
                   placeholder="Order number, email or customer name" />
        </div>
        <div class="col-8 col-md-4">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    if (Model.Status == status)
                    {
                        <option value="@status" selected>@status.ToDisplay()</option>
                    }
                    else
                    {
                        <option value="@status">@status.ToDisplay()</option>
                    }
                }
            </select>
        </div>
        <div class="col-4 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Orders" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-sticky-head mb-0">
            <thead>
                <tr>
                    <th scope="col">Order</th>
                    <th scope="col">Placed</th>
                    <th scope="col">Customer</th>
                    <th scope="col" class="text-end">Items</th>
                    <th scope="col" class="text-end">Total</th>
                    <th scope="col">Status</th>
                    <th scope="col">Tracking</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold text-decoration-none"
                               asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">@order.OrderNumber</a>
                        </td>
                        <td class="small text-muted text-nowrap">@order.PlacedUtc.ToString("d MMM yyyy HH:mm")</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(order.CustomerName) ? "—" : order.CustomerName)
                            <div class="small text-muted">@order.Email</div>
                        </td>
                        <td class="text-end">@order.TotalQuantity</td>
                        <td class="text-end text-nowrap">@Money(order.GrandTotal)</td>
                        <td><span class="badge @order.Status.ToCssClass()">@order.Status.ToDisplay()</span></td>
                        <td class="small text-muted">@(string.IsNullOrWhiteSpace(order.TrackingNumber) ? "—" : order.TrackingNumber)</td>
                    </tr>
                }

                @if (Model.Orders.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No orders match this filter.
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Show all orders</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
