@model PostSaleRequest
@inject WebDS_Test.Services.ICurrencyFormatter Money
@{
    var request = Model;
    var nextStates = request.Status.AllowedTransitions();
    var canDecide = request.Status == PostSaleStatus.Pending;
    var canProcess = request.Status is PostSaleStatus.Approved or PostSaleStatus.Received;
    var remedy = request.IsPromoCodeRefund
        ? $"{Money.Format(request.RefundAmount)} promo code"
        : request.RefundAmount > 0
            ? Money.Format(request.RefundAmount)
            : request.Type == PostSaleType.Exchange ? "Replacement" : "No monetary remedy";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">@request.Reference</h1>
            <p class="text-muted mb-0">
                @request.Type.ToDisplay() · @(request.IsOrderLevel ? "whole order" : request.OrderLine?.ProductName)
                · raised @request.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @request.Status.ToCssClass() fs-6">@request.Status.ToDisplay()</span>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to queue</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card mb-3">
                <div class="card-header"><h2 class="h6 mb-0">Request</h2></div>
                <div class="card-body">
                    <dl class="row small mb-0">
                        <dt class="col-sm-4">Order</dt>
                        <dd class="col-sm-8">
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@request.OrderId">
                                @(request.Order?.OrderNumber ?? $"#{request.OrderId}")
                            </a>
                            <span class="text-muted">· @request.Order?.CustomerName &lt;@request.Order?.Email&gt;</span>
                        </dd>

                        <dt class="col-sm-4">Shop</dt>
                        <dd class="col-sm-8">@(request.Shop?.Name ?? "(shop removed)")</dd>

                        <dt class="col-sm-4">Reason</dt>
                        <dd class="col-sm-8">@request.Reason.ToDisplay()</dd>

                        <dt class="col-sm-4">Remedy</dt>
                        <dd class="col-sm-8">
                            @remedy
                            @if (!string.IsNullOrWhiteSpace(request.PromoCode))
                            {
                                <div>Code: <code>@request.PromoCode</code></div>
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(request.ReasonDetail))
                        {
                            <dt class="col-sm-4">Customer note</dt>
                            <dd class="col-sm-8" style="white-space: pre-line">@request.ReasonDetail</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(request.SerialNumber))
                        {
                            <dt class="col-sm-4">Serial number</dt>
                            <dd class="col-sm-8">@request.SerialNumber</dd>
                        }

                        @if (request.Type == PostSaleType.Warranty)
                        {
                            <dt class="col-sm-4">Warranty window</dt>
                            <dd class="col-sm-8">
                                @(request.WithinGracePeriod
                                    ? $"Inside the three-day window (ends {request.GracePeriodEndUtc:yyyy-MM-dd})"
                                    : $"Outside the window (purchase {request.PurchaseDateUtc:yyyy-MM-dd})")
                            </dd>
                            <dt class="col-sm-4">Repairable</dt>
                            <dd class="col-sm-8">@(request.CanBeRepaired ? "Yes" : "No")</dd>
                        }

                        @if (request.Type == PostSaleType.RTS)
                        {
                            <dt class="col-sm-4">Carrier</dt>
                            <dd class="col-sm-8">@(request.Carrier ?? "—")</dd>
                            <dt class="col-sm-4">Call attempts</dt>
                            <dd class="col-sm-8">@request.CallAttempts</dd>
                            @if (!string.IsNullOrWhiteSpace(request.ManifestNumber))
                            {
                                <dt class="col-sm-4">Manifest</dt>
                                <dd class="col-sm-8">@request.ManifestNumber</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(request.QualityReport))
                            {
                                <dt class="col-sm-4">Quality report</dt>
                                <dd class="col-sm-8" style="white-space: pre-line">@request.QualityReport</dd>
                            }
                        }

                        @if (!string.IsNullOrWhiteSpace(request.PickupTrackingNumber))
                        {
                            <dt class="col-sm-4">Pickup tracking</dt>
                            <dd class="col-sm-8">@request.PickupTrackingNumber</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(request.AdminNotes))
                        {
                            <dt class="col-sm-4">Operator notes</dt>
                            <dd class="col-sm-8" style="white-space: pre-line">@request.AdminNotes</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><h2 class="h6 mb-0">Fee split (fixed at intake)</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th scope="col">Cost</th><th scope="col">Borne by</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Item price</td><td>@request.FeeAllocation.ItemPriceBearer.ToDisplay()</td></tr>
                            <tr><td>Shipping</td><td>@request.FeeAllocation.ShippingFeeBearer.ToDisplay()</td></tr>
                            <tr><td>Card fee</td><td>@request.FeeAllocation.CreditCardFeeBearer.ToDisplay()</td></tr>
                            <tr><td>Pickup</td><td>@request.FeeAllocation.PickupFeeBearer.ToDisplay()</td></tr>
                            <tr><td>Return</td><td>@request.FeeAllocation.ReturnFeeBearer.ToDisplay()</td></tr>
                            <tr><td>Replacement</td><td>@request.FeeAllocation.ReplacementFeeBearer.ToDisplay()</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h2 class="h6 mb-0">Timeline</h2></div>
                <div class="card-body">
                    <ol class="list-unstyled mb-0">
                        @foreach (var step in request.StatusHistory.OrderBy(h => h.CreatedUtc))
                        {
                            <li class="d-flex gap-3 pb-2">
                                <span class="text-muted small text-nowrap">@step.CreatedUtc.ToString("dd MMM HH:mm")</span>
                                <span>
                                    <span class="badge @step.ToStatus.ToCssClass()">@step.ToStatus.ToDisplay()</span>
                                    @if (!string.IsNullOrWhiteSpace(step.ChangedBy))
                                    {
                                        <span class="small text-muted">by @step.ChangedBy</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(step.Note))
                                    {
                                        <div class="small">@step.Note</div>
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            @if (canDecide)
            {
                <div class="card mb-3">
                    <div class="card-header"><h2 class="h6 mb-0">Decision</h2></div>
                    <div class="card-body">
                        <form asp-action="Approve" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            <label class="form-label small" for="approve-note">Note (optional)</label>
                            <textarea id="approve-note" name="note" class="form-control form-control-sm mb-2" rows="2"></textarea>
                            <button class="btn btn-success btn-sm w-100">Approve</button>
                        </form>
                        <form asp-action="Reject" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            <label class="form-label small" for="reject-note">Why is it declined? (shown to the customer)</label>
                            <textarea id="reject-note" name="note" class="form-control form-control-sm mb-2" rows="2"></textarea>
                            <button class="btn btn-outline-danger btn-sm w-100">Reject</button>
                        </form>
                    </div>
                </div>
            }

            @if (nextStates.Count > 0 && !canDecide)
            {
                <div class="card mb-3">
                    <div class="card-header"><h2 class="h6 mb-0">Move the process on</h2></div>
                    <div class="card-body">
                        <form asp-action="Transition" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            <label class="form-label small" for="next">Next state</label>
                            <select id="next" name="next" class="form-select form-select-sm mb-2">
                                @foreach (var state in nextStates)
                                {
                                    <option value="@state">@state.ToDisplay()</option>
                                }
                            </select>
                            <label class="form-label small" for="pickup">Pickup tracking (optional)</label>
                            <input id="pickup" name="pickupTrackingNumber" class="form-control form-control-sm mb-2" />
                            <label class="form-label small" for="transition-note">Note (optional)</label>
                            <textarea id="transition-note" name="note" class="form-control form-control-sm mb-2" rows="2"></textarea>
                            <button class="btn btn-primary btn-sm w-100">Update</button>
                        </form>
                    </div>
                </div>
            }

            @if (request.Type == PostSaleType.Warranty &&
                 request.Status is PostSaleStatus.Approved or PostSaleStatus.Received)
            {
                <div class="card mb-3">
                    <div class="card-header"><h2 class="h6 mb-0">Warranty triage</h2></div>
                    <div class="card-body">
                        <p class="small text-muted">
                            Decide what the seller can do. A repair means no refund; if the item
                            cannot be repaired, the goods are refunded.
                        </p>
                        <form asp-action="TriageWarranty" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" id="repairable"
                                       name="canBeRepaired" value="true"
                                       checked="@request.CanBeRepaired" />
                                <label class="form-check-label small" for="repairable">Can be repaired</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="replaceable"
                                       name="canBeReplaced" value="true"
                                       checked="@request.CanBeReplaced" />
                                <label class="form-check-label small" for="replaceable">Can be replaced</label>
                            </div>
                            <textarea name="note" class="form-control form-control-sm mb-2" rows="2"
                                      placeholder="Assessment note (optional)"></textarea>
                            <button class="btn btn-outline-primary btn-sm w-100">Save triage</button>
                        </form>
                    </div>
                </div>
            }

            @if (canProcess)
            {
                <div class="card mb-3 border-success">
                    <div class="card-header"><h2 class="h6 mb-0">Issue the remedy</h2></div>
                    <div class="card-body">
                        <p class="small text-muted">
                            @(request.IsPromoCodeRefund
                                ? "A single-use promo code worth the goods value will be issued."
                                : request.RefundAmount > 0
                                    ? $"{Money.Format(request.RefundAmount)} will be recorded as refunded against the order."
                                    : "No money is due under the applicable rules.")
                        </p>
                        <form asp-action="Process" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            @if (request.Type == PostSaleType.Exchange)
                            {
                                <label class="form-label small" for="replacement">Replacement variant id (optional)</label>
                                <input id="replacement" name="replacementVariantId" type="number" min="1"
                                       class="form-control form-control-sm mb-2" />
                            }
                            <label class="form-label small" for="process-note">Note (optional)</label>
                            <textarea id="process-note" name="note" class="form-control form-control-sm mb-2" rows="2"></textarea>
                            <button class="btn btn-success btn-sm w-100">Complete</button>
                        </form>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header"><h2 class="h6 mb-0">Conversation</h2></div>
                <div class="card-body">
                    @if (request.Messages.Count == 0)
                    {
                        <p class="text-muted small mb-3">No messages yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-3">
                            @foreach (var entry in request.Messages.OrderBy(m => m.CreatedUtc))
                            {
                                <li class="mb-3">
                                    <div class="small text-muted">
                                        <strong>@(entry.IsFromCustomer ? "Customer" : "LibanPost")</strong>
                                        · @entry.CreatedUtc.ToString("dd MMM HH:mm")
                                    </div>
                                    <div class="small" style="white-space: pre-line">@entry.Content</div>
                                </li>
                            }
                        </ul>
                    }

                    <form asp-action="Message" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@request.Id" />
                        <textarea name="content" class="form-control form-control-sm mb-2" rows="3"
                                  maxlength="2000" placeholder="Reply to the customer…"></textarea>
                        <button class="btn btn-outline-primary btn-sm">Send</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
