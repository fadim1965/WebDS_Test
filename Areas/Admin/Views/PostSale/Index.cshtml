@model IReadOnlyList<PostSaleRequest>
@inject WebDS_Test.Services.ICurrencyFormatter Money
@{
    var status = ViewData["Status"] as PostSaleStatus?;
    var type = ViewData["Type"] as PostSaleType?;
    var search = ViewData["Search"] as string;
    var counts = ViewData["Counts"] as PostSaleCounts;
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
        <div>
            <h1 class="h3 mb-1">After-sales queue</h1>
            <p class="text-muted mb-0">
                Cancellations, returns, exchanges, return-to-sender cases and warranty claims.
                <strong>@(counts?.Pending ?? 0)</strong> awaiting decision,
                <strong>@(counts?.InProgress ?? 0)</strong> in progress.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary btn-sm" asp-action="Fulfilments">Packages &amp; labels</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Rts">Record a return to sender</a>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-center mt-2 mb-3">
        <div class="col-auto">
            <label class="form-label small mb-0" for="status">Status</label>
            <select id="status" name="status" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<PostSaleStatus>())
                {
                    <option value="@s" selected="@(status == s)">@s.ToDisplay()</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small mb-0" for="type">Process</label>
            <select id="type" name="type" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var t in Enum.GetValues<PostSaleType>())
                {
                    <option value="@t" selected="@(type == t)">@t.ToDisplay()</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small mb-0" for="search">Search</label>
            <input id="search" name="search" class="form-control form-control-sm"
                   placeholder="PSR-…, order, customer or email" value="@search" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary btn-sm">Filter</button>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Clear</a>
        </div>
    </form>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Order</th>
                        <th>Shop</th>
                        <th>Process</th>
                        <th>Raised</th>
                        <th class="text-end">Remedy</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No requests match this view.</td></tr>
                    }
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td><strong>@request.Reference</strong></td>
                            <td class="small">
                                @(request.Order?.OrderNumber ?? $"#{request.OrderId}")
                                <div class="text-muted">@request.Order?.CustomerName</div>
                            </td>
                            <td class="small">@(request.Shop?.Name ?? "(shop removed)")</td>
                            <td class="small">
                                @request.Type.ToDisplay()
                                <div class="text-muted">
                                    @(request.IsOrderLevel ? "Whole order" : request.OrderLine?.ProductName)
                                </div>
                            </td>
                            <td class="small text-nowrap">@request.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end text-nowrap">
                                @if (request.IsPromoCodeRefund)
                                {
                                    <span>@Money.Format(request.RefundAmount)</span>
                                    <div class="small text-muted">promo code</div>
                                }
                                else if (request.RefundAmount > 0)
                                {
                                    <span>@Money.Format(request.RefundAmount)</span>
                                }
                                else if (request.Type == PostSaleType.Exchange)
                                {
                                    <span class="small text-muted">Replacement</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @request.Status.ToCssClass()">@request.Status.ToDisplay()</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@request.Id">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
