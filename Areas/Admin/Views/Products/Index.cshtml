@using Microsoft.Extensions.Options
@model AdminProductListViewModel
@inject IOptions<StoreSettings> StoreOptions
@{
    var currency = StoreOptions.Value.CurrencySymbol;
    var state = Model.State ?? string.Empty;

    string Money(decimal value) => currency + value.ToString("N2");
    string PriceRange(decimal min, decimal max) => min == max ? Money(min) : Money(min) + " – " + Money(max);
    string Plural(int count, string singular) => count == 1 ? $"{count} {singular}" : $"{count} {singular}s";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Products</h2>
        <p class="text-muted small mb-0">@Plural(Model.Rows.Count, "product") listed.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group btn-group-sm" role="group" aria-label="Export products">
            <a class="btn btn-outline-secondary"
               asp-area="Admin" asp-controller="Products" asp-action="Export"
               asp-route-q="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-state="@Model.State"
               asp-route-format="csv">Export CSV</a>
            <a class="btn btn-outline-secondary"
               asp-area="Admin" asp-controller="Products" asp-action="Export"
               asp-route-q="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-state="@Model.State"
               asp-route-format="excel">Export Excel</a>
        </div>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Products" asp-action="Create">New product</a>
    </div>
</div>

@* ---- Filters. A GET form so the page can be bookmarked and shared. ---- *@
<form method="get" asp-area="Admin" asp-controller="Products" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label" for="q">Search</label>
            <input class="form-control" type="search" id="q" name="q" value="@Model.Search" placeholder="Product name or SKU" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="categoryId">Category</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="state">State</label>
            <select class="form-select" id="state" name="state">
                <option value="" selected="@(state.Length == 0)">Active</option>
                <option value="draft" selected="@(state == "draft")">Draft</option>
                <option value="outofstock" selected="@(state == "outofstock")">Out of stock</option>
                <option value="deleted" selected="@(state == "deleted")">Deleted</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Products" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-sticky-head mb-0">
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Category</th>
                    <th scope="col" class="text-end">Variants</th>
                    <th scope="col" class="text-end">Stock</th>
                    <th scope="col" class="text-end">Price range</th>
                    <th scope="col">Status</th>
                    <th scope="col">Updated</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr class="@(row.IsDeleted ? "opacity-75" : string.Empty)">
                        <td>
                            <a class="fw-semibold text-decoration-none"
                               asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@row.Id">@row.Name</a>
                            <div class="small text-muted"><code>@row.Slug</code></div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(row.CategoryName) ? "Uncategorised" : row.CategoryName)</td>
                        <td class="text-end">@row.VariantCount</td>
                        <td class="text-end">
                            @if (row.TotalStock <= 0)
                            {
                                <span class="badge text-bg-danger">0</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light border">@row.TotalStock</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (row.VariantCount == 0)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @PriceRange(row.MinPrice, row.MaxPrice)
                            }
                        </td>
                        <td>
                            @if (row.IsDeleted)
                            {
                                <span class="badge text-bg-danger">Deleted</span>
                            }
                            else if (row.IsPublished)
                            {
                                <span class="badge text-bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Draft</span>
                            }
                            @if (row.IsFeatured)
                            {
                                <span class="badge text-bg-warning">Featured</span>
                            }
                        </td>
                        <td class="small text-muted text-nowrap">@row.UpdatedUtc.ToString("d MMM yyyy")</td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@row.Id">Edit</a>

                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@row.Slug">View in shop</a>

                                <form method="post" asp-area="Admin" asp-controller="Products" asp-action="TogglePublished">
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        @(row.IsPublished ? "Unpublish" : "Publish")
                                    </button>
                                </form>

                                @if (row.IsDeleted)
                                {
                                    <form method="post" asp-area="Admin" asp-controller="Products" asp-action="Restore">
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-area="Admin" asp-controller="Products" asp-action="Delete"
                                          onsubmit="return confirm('Delete this product? It will be hidden from the shop and can be restored from the Deleted filter.');">
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }

                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No products match this filter.
                            <a asp-area="Admin" asp-controller="Products" asp-action="Create">Add a product</a>
                            or
                            <a asp-area="Admin" asp-controller="Products" asp-action="Index">clear the filters</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
