@model AdminEmailListViewModel
@{
    ViewData["Title"] = "Emails";
    var statuses = new[]
    {
        EmailStatus.Queued, EmailStatus.Sent, EmailStatus.Failed, EmailStatus.Skipped
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Transactional email</h2>
        <p class="text-muted small mb-0">
            Everything the store has queued or sent. Messages are written here first and delivered by a
            background dispatcher, so a failure never interrupts a shopper's request.
        </p>
    </div>

    <form method="get" asp-action="Index" class="d-flex align-items-end gap-2">
        <input type="hidden" name="status" value="@Model.Status" />
        <div>
            <label class="form-label small text-muted mb-1" for="kindFilter">Type</label>
            <select class="form-select form-select-sm" id="kindFilter" name="kind" onchange="this.form.submit()">
                <option value="">All types</option>
                @foreach (var option in Model.Kinds)
                {
                    <option value="@option" selected="@(Model.Kind == option)">@EmailDisplay.Kind(option)</option>
                }
            </select>
        </div>
        <noscript><button class="btn btn-sm btn-primary" type="submit">Apply</button></noscript>
    </form>
</div>

@* Status chips, counts from a single grouped query. *@
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(Model.Status is null ? "btn-primary" : "btn-outline-secondary")"
       asp-action="Index" asp-route-kind="@Model.Kind">
        All <span class="badge text-bg-light ms-1">@Model.Counts.Total</span>
    </a>
    @foreach (var state in statuses)
    {
        <a class="btn btn-sm @(Model.Status == state ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Index" asp-route-status="@state" asp-route-kind="@Model.Kind">
            @EmailDisplay.Status(state) <span class="badge text-bg-light ms-1">@Model.CountFor(state)</span>
        </a>
    }
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="small text-muted">
            <strong>Transport:</strong> configured in <code>Email:Transport</code>. The default writes
            <code>.eml</code> files; no mail server is required to exercise this page.
        </div>
        <form method="post" asp-action="SendTest" class="d-flex align-items-end gap-2">
            <input type="hidden" name="status" value="@Model.Status" />
            <input type="hidden" name="kind" value="@Model.Kind" />
            <input type="hidden" name="page" value="@Model.Messages.Page" />
            <div>
                <label class="form-label small text-muted mb-1" for="testTo">Send a test to</label>
                <input class="form-control form-control-sm" id="testTo" name="to" type="email"
                       value="@Model.TestAddress" style="min-width:16rem" />
            </div>
            <button class="btn btn-sm btn-outline-primary" type="submit">Send test</button>
        </form>
    </div>
</div>

@if (Model.Messages.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            No messages match this filter.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width:22%">Recipient</th>
                        <th scope="col">Subject</th>
                        <th scope="col" style="width:13%">Type</th>
                        <th scope="col" style="width:10%">Status</th>
                        <th scope="col" style="width:11%">Queued</th>
                        <th scope="col" style="width:16%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Messages.Items)
                    {
                        <tr>
                            <td class="small">@row.Recipient</td>
                            <td>
                                <a class="text-decoration-none fw-semibold" asp-action="Details" asp-route-id="@row.Id">
                                    @row.Subject
                                </a>
                                @if (row.OrderId is not null)
                                {
                                    <div class="small text-muted">Order #@row.OrderId</div>
                                }
                            </td>
                            <td class="small">@row.KindLabel</td>
                            <td>
                                <span class="badge @row.StatusCss">@row.StatusLabel</span>
                                @if (row.Attempts > 0)
                                {
                                    <div class="small text-muted">@row.Attempts attempt@(row.Attempts == 1 ? string.Empty : "s")</div>
                                }
                            </td>
                            <td class="small text-muted">@row.CreatedUtc.ToString("d MMM yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@row.Id">View</a>
                                    @if (row.IsRetryable)
                                    {
                                        <form method="post" asp-action="Resend">
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <input type="hidden" name="status" value="@Model.Status" />
                                            <input type="hidden" name="kind" value="@Model.Kind" />
                                            <input type="hidden" name="page" value="@Model.Messages.Page" />
                                            <button class="btn btn-sm btn-outline-primary" type="submit">Resend</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Messages.TotalPages > 1)
    {
        <nav aria-label="Email outbox pages" class="mt-3">
            <ul class="pagination justify-content-center flex-wrap mb-0">
                <li class="page-item @(Model.Messages.HasPrevious ? string.Empty : "disabled")">
                    @if (Model.Messages.HasPrevious)
                    {
                        <a class="page-link" asp-action="Index" asp-route-status="@Model.Status"
                           asp-route-kind="@Model.Kind" asp-route-page="@(Model.Messages.Page - 1)">Previous</a>
                    }
                    else
                    {
                        <span class="page-link">Previous</span>
                    }
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page @Model.Messages.Page of @Model.Messages.TotalPages</span>
                </li>
                <li class="page-item @(Model.Messages.HasNext ? string.Empty : "disabled")">
                    @if (Model.Messages.HasNext)
                    {
                        <a class="page-link" asp-action="Index" asp-route-status="@Model.Status"
                           asp-route-kind="@Model.Kind" asp-route-page="@(Model.Messages.Page + 1)">Next</a>
                    }
                    else
                    {
                        <span class="page-link">Next</span>
                    }
                </li>
            </ul>
        </nav>
    }
}
