{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Database": {
      "Enabled": true,
      "Application": "WebDS_Test",
      "QueueCapacity": 10000,
      "BatchSize": 100,
      "FlushSeconds": 2,
      "RetentionDays": 0,
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/store.db",
    // SQL credentials live in appsettings.Local.json (gitignored) — see Program.cs.
    // Left empty here: with no credentials the app falls back to the SQLite store,
    // which is the documented behaviour for a fresh clone without that file.
    "MultiVendorsStoresConn": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateFromSqlite": true,
    "SqliteSource": "App_Data/store.db"
  },
  "Store": {
    "Name": "LibanPost eShop",
    "Tagline": "Postal services and supplies, delivered across Lebanon.",
    "SupportEmail": "support@libanpost.example",
    "DefaultCountry": "Lebanon",
    "CurrencySymbol": "$",
    "Currency": "USD",
    /* Bootstrap defaults for the LBP display figure; the authoritative rate lives in the
       database and is maintained on Admin > Settings. AlternateRate <= 0 turns it off. */
    "AlternateCurrency": "LBP",
    "AlternateCurrencySymbol": "LL",
    "AlternateRate": 89500,
    "FlatShippingRate": 4.50,
    "FreeShippingThreshold": 60.00,
    "TaxRate": 0.11,
    "ProductsPerPage": 12,
    "LowStockThreshold": 5,
    "Theme": 4 /*1 (Amazon), 2 (eBay), 3 (Etsy), or 4 (Midnight & Gold)*/
  },
  "Reviews": {
    "AutoPublish": true,
    "MinBodyLength": 10,
    "MaxBodyLength": 4000,
    "PageSize": 5,
    "TopRatedMinCount": 15,
    "TopRatedMinAverage": 4.5,
    "StarSellerMinCount": 5,
    "StarSellerMinAverage": 4.2
  },
  "Email": {
    "Enabled": true,
    "Transport": "File",
    "FromAddress": "no-reply@libanpost.example",
    "FromName": "LibanPost eShop",
    "ReplyTo": "support@libanpost.example",
    "DropFolder": "App_Data/outbox",
    "MaxAttempts": 4,
    "PollSeconds": 5,
    "BatchSize": 25,
    "RetryBaseSeconds": 30,
    "PasswordResetMinutes": 120,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "Password": ""
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Checkout": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Review": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Messaging": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Webhook": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "Payouts": {
    "MinimumAmount": 0.00,
    "DefaultMethod": "Bank transfer"
  },
  "Branding": {
    "BrandName": "LibanPost",
    "LogoUrl": null,
    "LogoHeight": 52,
    "Primary": "#006db7",
    "PrimaryDark": "#015a97",
    "PrimaryDarker": "#0b5f98",
    "PrimaryLight": "#2683c2",
    "PrimaryTint": "#c9e0f0",
    "Accent": "#fed300",
    "AccentDark": "#e0b900",
    "Ink": "#1a1a1a",
    "InkMuted": "#2a4c62",
    "InkSubtle": "#6b6b6b",
    "Surface": "#ffffff",
    "SurfaceMuted": "#f6f6f6",
    "SurfaceRaised": "#f1f1f1",
    "Border": "#e6e6e6",
    "BorderStrong": "#d7d7d7",
    "Danger": "#e33c3c",
    "Success": "#2e7d32",
    "Radius": 4,
    "Shadow": "0 1px 3px rgba(0,0,0,.10)"
  },
  "Shopify": {
    "Enabled": false,
    "ShopDomain": "",
    "StorefrontAccessToken": "",
    "ApiVersion": "2026-10",
    "UseMockData": true,
    "CountryCode": null,
    "LanguageCode": null,
    "MaxPageSize": 24,
    "TimeoutSeconds": 20,
    "CacheSeconds": 60
  },
  "Payments": {
    "Provider": "simulator"
    // WebhookSecret is intentionally absent: the real value lives in
    // appsettings.Local.json (gitignored), and when no value is configured
    // PaymentSettings falls back to its built-in dev default.
  },
  "Shipping": {
    "Provider": "simulator",
    "BaseUrl": "",
    "ApiKey": "",
    "AccountNumber": "",
    "ApiKeyHeader": null,
    "DefaultWeightGrams": 500,
    "DefaultShippingCost": 4.5,
    "DefaultTransitDays": 2,
    "EnableCashOnDelivery": true,
    "TimeoutSeconds": 25,
    "MaxCodAmount": 5000
  },
  "Images": {
    "Folder": "App_Data/uploads",
    "RequestPath": "/uploads",
    "MaxBytes": 5242880,
    "MaxPerProduct": 10,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ]
  },
  "Seed": {
    "AdminEmail": "admin@libanpost.example",
    "AdminPassword": "Admin#12345"
  }
}


